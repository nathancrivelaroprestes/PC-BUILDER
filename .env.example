# ==========================================
# NEXUS RIGS - Variáveis de Ambiente
# ==========================================

# Conexão com o banco de dados PostgreSQL Serverless (Neon / Vercel Postgres)
# Formato: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_xxx@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth v5 Secret (gere usando: openssl rand -base64 32 ou npx auth secret)
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# NextAuth URL (opcional no NextAuth v5 em localhost/Vercel, mas recomendado documentar)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (obtidos no Google Cloud Console -> APIs & Services -> Credentials)
# URI de Redirecionamento Autorizada: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"
